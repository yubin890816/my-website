# 后端环境变量模板（复制为 .env 并填入真实值）

# JWT 配置
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# CORS 允许的前端 origin（逗号分隔）
CORS_ORIGINS=http://localhost:5173,https://yubin890816.github.io

# 数据库
DATABASE_URL=sqlite:///./studypal.db

# DeepSeek（AI 对话，key 仅存后端，不暴露给前端）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
